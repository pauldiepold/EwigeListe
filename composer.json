{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "anhskohbo/no-captcha": "^3.8",
        "doctrine/dbal": "^4.5",
        "guzzlehttp/guzzle": "^7.10",
        "inertiajs/inertia-laravel": "^3.0",
        "intervention/image-laravel": "^4.0",
        "laravel/framework": "^13.0",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "laravel/wayfinder": "^0.1.23",
        "pusher/pusher-php-server": "^7.3",
        "spatie/laravel-ignition": "^2.12",
        "yajra/laravel-datatables-oracle": "^13.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.23",
        "filp/whoops": "^2.18",
        "laravel/boost": "^2.10",
        "laravel/pint": "^1.32",
        "laravel/telescope": "^5.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^13.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "autoload": {
        "files": [
            "app/Helper/helper.php"
        ],
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "@php artisan boost:update --ansi"
        ]
    }
}
